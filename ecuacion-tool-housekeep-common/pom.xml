<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>ecuacion-tool-housekeep-common</artifactId>
	<packaging>jar</packaging>
	<parent>
		<groupId>jp.ecuacion.tool</groupId>
		<artifactId>ecuacion-tool-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>

	<build>
		<resources>
			<!-- Enable filtering only for version_ecuacion-tools.properties, so that
			     @project.version@ is replaced with this project's actual version at build
			     time. Other resource files are intentionally excluded from filtering to avoid
			     unintended substitution of "@...@" or "${...}" patterns they may contain.
			     No unsuffixed version.properties here, deliberately: this module is also a
			     dependency of ecuacion-references-tools (for this file, to show a version on
			     its navbar), and that app also carries its own unsuffixed version.properties
			     (via ecuacion-references-internal-utils) to show its own version on splib-web's
			     built-in config page. If this module carried an unsuffixed version.properties
			     too, both would land on ecuacion-references-tools' classpath under the same
			     name, and VersionUtil.getVersion("") would resolve to whichever one the
			     classloader happens to find first — not reliably references' own.
			     ecuacion-tool-housekeep-db and ecuacion-tool-housekeep-files each carry their
			     own unsuffixed version.properties instead, since ecuacion-references-tools
			     does not depend on either of those. -->
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>version_ecuacion-tools.properties</include>
				</includes>
				<filtering>true</filtering>
			</resource>
		</resources>
	</build>

	<dependencies>

		<!-- spring boot -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- ecuacion-splib -->
		<dependency>
			<groupId>jp.ecuacion.splib</groupId>
			<artifactId>ecuacion-splib-batch</artifactId>
		</dependency>

		<!-- ecuacion-util -->
		<dependency>
			<groupId>jp.ecuacion.util</groupId>
			<artifactId>ecuacion-util-excel-table</artifactId>
		</dependency>

		<!-- ecuacion-lib -->
		<dependency>
			<groupId>jp.ecuacion.lib</groupId>
			<artifactId>ecuacion-lib-validation-business-messages</artifactId>
		</dependency>

	</dependencies>
</project>
