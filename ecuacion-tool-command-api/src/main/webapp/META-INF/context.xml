<!--
  Place environment-specific config files (application.properties,
  ecuacion-tool-command-api-scripts.properties, logback-spring.xml, etc.) under:

    ${catalina.base}/app-conf/ecuacion-tool-command-api/
      (e.g. /usr/local/tomcat/app-conf/ecuacion-tool-command-api/)

  This directory doesn't need to exist beforehand — SplibAppConfDirLifecycleListener
  (see below) creates it at startup if missing, instead of Tomcat failing to deploy
  with an IllegalArgumentException the way a plain <PreResources> would.

  This directory's location can be overridden per deployment, without editing this
  file, via the jp.ecuacion.tool.command-api.app-conf-dir system property (e.g. in
  Tomcat's setenv.sh) — e.g. point it directly at ${catalina.base}/app-conf if you'd
  rather skip the app-specific subdirectory. See SplibAppConfDirLifecycleListener in
  ecuacion-splib-core for details.
-->
<Context>
	<Listener className="jp.ecuacion.splib.core.tomcat.SplibAppConfDirLifecycleListener"
			customPathPropertyName="jp.ecuacion.tool.command-api.app-conf-dir"
			defaultPath="${catalina.base}/app-conf/ecuacion-tool-command-api"
			createDefaultPathIfMissing="true"/>
</Context>
