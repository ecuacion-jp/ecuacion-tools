<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>ecuacion-tool-housekeep-db</artifactId>
	<packaging>jar</packaging>
	<parent>
		<groupId>jp.ecuacion.tool</groupId>
		<artifactId>ecuacion-tool-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>

	<build>
		<plugins>

			<!-- for batch -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

		</plugins>
	</build>
	<dependencies>

		<!-- spring boot -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		
		<!-- ecuacion-splib -->
		<dependency>
			<groupId>jp.ecuacion.splib</groupId>
			<artifactId>ecuacion-splib-batch</artifactId>
		</dependency>

		<!-- ecuacion-util -->
		<dependency>
			<groupId>jp.ecuacion.util</groupId>
			<artifactId>ecuacion-util-excel-table</artifactId>
		</dependency>
		
		<!-- ecuacion-lib -->
		<dependency>
			<groupId>jp.ecuacion.lib</groupId>
			<artifactId>ecuacion-lib-validation-business-messages</artifactId>
		</dependency>

		<!-- other -->

		<!-- DB driver -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mariadb.jdbc</groupId>
			<artifactId>mariadb-java-client</artifactId>
		</dependency>

		<!-- Real Postgres for tests, launched without Docker (see HousekeepDbTaskletTest). -->
		<dependency>
			<groupId>io.zonky.test</groupId>
			<artifactId>embedded-postgres</artifactId>
			<version>2.1.0</version>
			<scope>test</scope>
		</dependency>

		<!-- No true embedded MySQL exists, so MySQL/MariaDB-flavored SQL is verified against H2's
		     MySQL compatibility mode instead (see HousekeepDbTaskletMysqlTest). -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>
</project>
